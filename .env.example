# Redis Configuration
REDIS_PASSWORD=generate_a_secure_redis_password_2026

# n8n Secret Keys
N8N_ENCRYPTION_KEY=generate_n8n_master_encryption_key_2026

# Open WebUI Secret
WEBUI_SECRET_KEY=generate_webui_auth_secret_key_2026
