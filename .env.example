# StackForge™ Production Configuration
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# PostgreSQL Configuration
POSTGRES_USER=stackforge_admin
POSTGRES_PASSWORD=generate_a_secure_32_character_hex_password
